# Copy to .env and adjust. Never commit .env.

# Public address of the SSO server. This becomes the token issuer, so apps must use the same value.
SSO_PUBLIC_URL=http://localhost:9000
SSO_PORT=9000

# Name shown on the sign-in and account pages.
SSO_APP_NAME=Acme ID

# The first administrator (username: admin). Used once, when the database is empty.
# ADMIN_USERNAME=admin   (optional)
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# 1 while developing your theme: shows template errors in the browser instead of the built-in page.
SSO_DEBUG=1

# What people type to sign in: username (default), email or username_or_email.
# The email modes need a different email address per user.
# SSO_LOGIN_IDENTIFIER=username

# Who must set up two-step verification: optional (default), admins or everyone.
# An administrator can change it at /admin/security, and what is saved there wins.
# SSO_MFA_POLICY=optional

# Behind a reverse proxy, list its addresses (comma separated, CIDR ranges allowed).
# Without this, IP rules see the proxy's address instead of the visitor's.
# SSO_TRUSTED_PROXIES=172.18.0.0/16

# Sign in with another provider. Each one turns on when its client id is set.
# At the provider, register <SSO_PUBLIC_URL>/login/social/<google|github|oidc>/callback
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=
# SSO_GITHUB_CLIENT_ID=
# SSO_GITHUB_CLIENT_SECRET=
# Any other OpenID Connect provider (Microsoft, Okta, Keycloak...), under the button label you give:
# SSO_OIDC_ISSUER=
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_LABEL=Company login

# Which image to run, and where its source is if you build it yourself.
# By default `docker compose build` builds the release named in docker-compose.yml from GitHub.
# SSO_IMAGE=php-sso:local
# To build from a checkout of php-sso instead (the libraries come from Packagist either way):
# SSO_SOURCE=../php-sso
